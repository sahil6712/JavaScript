const args = process.argv.slice(2);

if (args.length !== 1) {
    process.exit(1);
}

const year = parseInt(args[0], 10);

// Leap Year Condition
const isLeapYear = (year % 4 === 0 && year % 100 !== 0) || (year % 400 === 0);

console.log(isLeapYear ? `${year} is a Leap Year` : `${year} is not a Leap Year`);
